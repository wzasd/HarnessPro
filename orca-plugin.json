{
  "manifestVersion": 1,
  "id": "orca",
  "publisher": "harnesspro",
  "name": "HarnessPro",
  "version": "0.2.3",
  "description": "Run shared agent-budget checks and inspect their status from Orca.",
  "engines": { "orca": ">=1.4.0" },
  "pluginApi": 1,
  "main": "main.mjs",
  "contributes": {
    "panels": [
      { "id": "main", "title": "HarnessPro", "icon": "plug", "entry": "panel.html" }
    ],
    "commands": [
      { "id": "run-checks", "title": "HarnessPro: Run checks", "context": "worktree" },
      { "id": "stop-checks", "title": "HarnessPro: Stop checks", "context": "worktree" },
      { "id": "status-checks", "title": "HarnessPro: Show check status", "context": "worktree" },
      { "id": "start-evolution", "title": "HarnessPro: Start evolution", "context": "worktree" },
      { "id": "stop-evolution", "title": "HarnessPro: Stop evolution", "context": "worktree" },
      { "id": "status-evolution", "title": "HarnessPro: Show evolution status", "context": "worktree" },
      { "id": "apply-evolution", "title": "HarnessPro: Apply medium candidate", "context": "worktree" }
    ],
    "keybindings": [
      { "command": "run-checks", "key": "Mod+Shift+L", "when": "worktree" },
      { "command": "start-evolution", "key": "Mod+Shift+H", "when": "worktree" },
      { "command": "status-evolution", "key": "Mod+Shift+J", "when": "worktree" },
      { "command": "stop-evolution", "key": "Mod+Shift+K", "when": "worktree" },
      { "command": "apply-evolution", "key": "Mod+Shift+A", "when": "worktree" }
    ]
  },
  "capabilities": [
    { "kind": "workspace:read" },
    { "kind": "terminal:send" },
    { "kind": "notifications:show" }
  ]
}
