{
  "manifestVersion": 1,
  "id": "orca",
  "publisher": "harnesspro",
  "name": "HarnessPro",
  "version": "0.1.0",
  "description": "Run shared agent-budget checks and inspect their status from Orca.",
  "engines": { "orca": ">=1.4.0" },
  "pluginApi": 1,
  "main": "main.mjs",
  "contributes": {
    "panels": [
      { "id": "main", "title": "HarnessPro", "icon": "plug", "entry": "panel.html" }
    ],
    "commands": [
      { "id": "run-checks", "title": "HarnessPro: Run checks", "context": "worktree" },
      { "id": "stop-checks", "title": "HarnessPro: Stop checks", "context": "worktree" },
      { "id": "status-checks", "title": "HarnessPro: Show check status", "context": "worktree" }
    ]
  },
  "capabilities": [
    { "kind": "workspace:read" },
    { "kind": "terminal:send" },
    { "kind": "notifications:show" }
  ]
}
